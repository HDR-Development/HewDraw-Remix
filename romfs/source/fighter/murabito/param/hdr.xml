        <int hash="cling_counter">3</int>
      </struct>
      <struct hash="4"> <!-- PURPLE -->
        <!-- The highest knockback growth of them all -->
        <!-- Purple Pikmin also possesses a hitbox on side special, making it unique in its zoning ability -->
