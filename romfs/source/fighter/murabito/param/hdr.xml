        <float hash="kbg_mul">1.1</float>
        <float hash="shield_damage_mul">0.0</float>
        <int hash="angle_mod">0</int>
        <float hash="hitlag_mul">1.1</float>
        <string hash="attr">collision_attr_normal</string>
        <string hash="attr_special">collision_attr_normal</string>
