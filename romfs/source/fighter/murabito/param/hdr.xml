        <float hash="kbg_mul">0.9</float>
        <float hash="shield_damage_mul">-0.2</float>
        <int hash="angle_mod">6</int>
        <float hash="hitlag_mul">1.25</float>
        <string hash="attr">collision_attr_elec</string>
        <string hash="attr_special">collision_attr_paralyze</string>
        <int hash="sound">7</int> <!-- COLLISION_SOUND_ATTR_ELEC -->
        <float hash="color_r">1.0</float>
        <float hash="color_g">1.0</float>
        <float hash="color_b">0.14</float>
        <int hash="cling_counter">7</int>
      </struct>
      <struct hash="2"> <!-- BLUE -->
        <!-- Vanilla stats -->
        <!-- Blue Pikmin's specialty is entirely in its unique throws -->
        <float hash="damage_mul">1.0</float>
        <float hash="kbg_mul">1.0</float>
        <float hash="shield_damage_mul">0.0</float>
        <int hash="angle_mod">0</int>
        <float hash="hitlag_mul">1.0</float>
        <string hash="attr">collision_attr_water</string>
        <string hash="attr_special">collision_attr_water</string>
        <int hash="sound">9</int> <!-- COLLISION_SOUND_ATTR_WATER -->
