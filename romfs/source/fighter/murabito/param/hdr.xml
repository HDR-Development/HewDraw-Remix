        <float hash="color_g">0.8</float>
        <float hash="color_b">2.0</float>
        <int hash="cling_counter">4</int>
      </struct>
      <struct hash="3"> <!-- WHITE -->
        <!-- Very high damage and shield damage, but no benefit to knockback -->
        <!-- The Flower special hit type and low counter makes White Pikmin an immediate threat -->
        <float hash="damage_mul">1.2</float>
        <float hash="kbg_mul">1.0</float>
        <float hash="shield_damage_mul">0.33</float>
        <int hash="angle_mod">0</int>
        <float hash="hitlag_mul">1.0</float>
        <string hash="attr">collision_attr_purple</string>
        <string hash="attr_special">collision_attr_flower</string>
